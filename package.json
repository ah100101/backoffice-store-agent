{
  "name": "backoffice-store-agent",
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "eve build",
    "deploy": "eve deploy",
    "dev": "eve dev",
    "eval": "eve eval",
    "evals": "eve eval --strict --exclude-tag judge",
    "evals:fixtures": "cd tests/fixtures/eval-agent && eve eval --strict",
    "start": "eve start",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@vercel/connect": "0.4.2",
    "ai": "7.0.112",
    "eve": "0.66.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.2",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "24.x"
  }
}
